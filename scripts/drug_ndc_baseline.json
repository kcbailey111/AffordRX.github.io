{
  "_readme": {
    "purpose": "Tells pricing_pipeline.py how to look up each drug in the government NADAC database.",
    "fields": {
      "name": "Must match the Name column in all_data.csv (e.g. Ibuprofen).",
      "quantity": "How many units your GoodRx page was for (e.g. 30 tablets). NADAC wholesale is multiplied by this.",
      "nadac_search": "Text to search on data.medicaid.gov. Use the exact strength/form you scraped.",
      "prefer": "Words that mean we found the RIGHT product (e.g. TABLET not SOFTGEL).",
      "exclude": "Words that mean we found the WRONG product (e.g. COD = acetaminophen with codeine)."
    },
    "example": "Ibuprofen 200mg 30ct on GoodRx -> quantity 30, nadac_search IBUPROFEN 200 MG TABLET"
  },
